#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
. scripts/test-lib

load_job .github/workflows/orbit-policy.yml policy
base_env=(GH_REPO=owner/repo "CC_PATTERN=$(jq -r '.jobs.policy.env.CC_PATTERN' "$tmp/workflow.json")")

fixture repos/owner/repo/issues/1 <<< '{"state": "open", "labels": []}'
fixture repos/owner/repo/issues/2 <<< '{"state": "open", "labels": [{"name": "needs-validation"}]}'
fixture repos/owner/repo/issues/3 <<< '{"state": "open", "labels": [{"name": "blocked"}]}'
fixture repos/owner/repo/issues/4 <<< '{"state": "closed", "labels": []}'
fixture repos/owner/repo/issues/5 <<< '{"state": "open", "labels": [], "pull_request": {"url": "x"}}'

step='PR is linked to a validated issue'
expect accept "$step" 'open issue without blocking label' AUTHOR=alice BODY='Closes #1' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect accept "$step" 'lowercase closes keyword' AUTHOR=alice BODY='closes #1' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect accept "$step" 'exempt bot without issue' AUTHOR='dependabot[bot]' BODY='' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'no Closes in the description' AUTHOR=alice BODY='Fixes the bug' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'other bot without issue' AUTHOR='agent[bot]' BODY='' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'issue with needs-validation' AUTHOR=alice BODY='Closes #2' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'issue with blocked' AUTHOR=alice BODY='Closes #3' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'closed issue' AUTHOR=alice BODY='Closes #4' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'pull request instead of an issue' AUTHOR=alice BODY='Closes #5' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'issue not found' AUTHOR=alice BODY='Closes #99' EXEMPT_BOTS='dependabot[bot] renovate[bot]'
expect refuse "$step" 'one valid issue and one not validated' AUTHOR=alice BODY='Closes #1, closes #2' EXEMPT_BOTS='dependabot[bot] renovate[bot]'

long_title="feat: $(printf 'a%.0s' {1..100})"

step='PR title follows Conventional Commits'
expect accept "$step" 'type and subject' TITLE='fix: reject overlapping bookings'
expect accept "$step" 'scope and breaking change' TITLE='feat(api)!: drop the v1 routes'
expect refuse "$step" 'no type' TITLE='Reject overlapping bookings'
expect refuse "$step" 'unknown type' TITLE='feature: add CSV export'
expect refuse "$step" 'uppercase scope' TITLE='fix(API): reject overlapping bookings'
expect refuse "$step" 'more than 100 characters' TITLE="$long_title"

fixture repos/owner/repo/pulls/10/commits << 'JSON'
[
  {"parents": [{}], "commit": {"message": "feat(export): add CSV export of bookings\n\nRefs: #15"}},
  {"parents": [{}, {}], "commit": {"message": "Merge branch 'main' into feat/15-csv-export"}},
  {"parents": [{}], "commit": {"message": "test: cover the empty export"}}
]
JSON
fixture repos/owner/repo/pulls/11/commits << 'JSON'
[
  {"parents": [{}], "commit": {"message": "feat(export): add CSV export of bookings"}},
  {"parents": [{}], "commit": {"message": "wip"}}
]
JSON

step='Commits follow Conventional Commits'
expect accept "$step" 'conforming commits, merge commit ignored' PR=10
expect refuse "$step" 'one commit without a type' PR=11

fixture repos/owner/repo/pulls/10/files <<< '[{"filename": "README.md"}, {"filename": "docs/context/architecture.md"}]'
fixture repos/owner/repo/pulls/11/files <<< '[{"filename": "README.md"}, {"filename": ".github/workflows/orbit.yml"}]'
fixture repos/owner/repo/pulls/12/files <<< '[{"filename": "AGENTS.md"}]'
fixture repos/owner/repo/pulls/13/files <<< '[{"filename": "docs/rules/git.md"}]'
fixture repos/owner/repo/pulls/14/files <<< '[{"filename": "docs/notes/git.md", "previous_filename": "docs/rules/git.md"}]'

step='Rules and CI only change with the rules-change label'
expect accept "$step" 'no protected file touched' PR=10 RULES_CHANGE=false
expect accept "$step" 'protected file with the label' PR=11 RULES_CHANGE=true
expect refuse "$step" '.github/ without the label' PR=11 RULES_CHANGE=false
expect refuse "$step" 'AGENTS.md without the label' PR=12 RULES_CHANGE=false
expect refuse "$step" 'docs/rules/ without the label' PR=13 RULES_CHANGE=false
expect refuse "$step" 'protected file renamed away without the label' PR=14 RULES_CHANGE=false

finish test-policy
