#!/usr/bin/env bash
set -euo pipefail

filter=.
path=
while [ $# -gt 0 ]; do
  case $1 in
    api | --paginate) ;;
    --jq)
      filter=$2
      shift
      ;;
    *) path=$1 ;;
  esac
  shift
done

file="$FIXTURES/$path.json"
if [ ! -f "$file" ]; then
  echo "gh: Not Found (HTTP 404)" >&2
  exit 1
fi
jq -r "$filter" "$file"
